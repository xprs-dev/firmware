# The c3xwifi env (the XPRS-WiFi relay) on top of sdkconfig.defaults.
# The full station does not fit beside the RF sample bank on this chip
# (src/xwifi_relay.c has the arithmetic), so only the relay build carries
# the bearer. CERT_TEST is the C3 port's stated requirement; the
# flash-placement lines it also asks for are in the base defaults, and
# 160 MHz is this chip's Kconfig default.
CONFIG_XPRS_WIFI8=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
# No Bluetooth and no Reticulum on the relay: the heap feeds the radio.
CONFIG_BT_ENABLED=n
CONFIG_XPRS_BEARER_RNS=n
