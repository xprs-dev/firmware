CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# This node exists to hear ESP-NOW. A station that modem-sleeps misses frames.
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# LVGL (managed component, configured via Kconfig — its CMake sets
# CONFIG_LV_CONF_SKIP=y, so lv_conf.h is ignored). Montserrat 14 is the
# Kconfig default; the bars use 12.
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_10=y
# 20 for one number: the count of stations in reach is the Radar's headline
# and was the same size as the labels around it.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 32, and measured: 24 was tried, to hand 8 KB back to an HTTP client for
# updates, and the renderer began missing its watchdog every seventy
# seconds -- the panels are labels, a table and three charts, and they need
# this pool. The conclusion is not "tune the number" but "this board is not
# the one that hosts a pull-OTA": see docs/device.md.
CONFIG_LV_MEM_SIZE_KILOBYTES=32
# The XPRS index names segments seg_<10 digits>.bin -- longer than 8.3, so
# without long-filename support every write fails while the accept counter
# still climbs. The dongle runs LFN_HEAP for the same reason.
CONFIG_FATFS_LFN_HEAP=y
# Phone browsers send >512B of headers (UA + Accept + our nsec cookie);
# the default answers them 431 'Header fields are too long'.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# A TASK WDT freeze reboots the board before the UART panic print can be
# read; the core dump keeps the culprit's name for the next boot.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ---- Over-the-air updates (XPRS.md 25.8) -------------------------------
# Rollback is the safety net that makes flashing a roof node reasonable: a
# new image boots PENDING_VERIFY and any reset before it marks itself valid
# sends the bootloader back to the slot that worked. The 90 s task watchdog
# (panic on trigger, already set) is what turns a hang into that reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Plain HTTP is deliberate. The image is authenticated by a signature over
# the xprsfw1 line (25.8), checked before a byte reaches flash, so the
# carrier needs no trust of its own -- and mbedtls TLS wants 20-40 KB of
# peak heap, which the dongle (about 13 KB free) simply does not have.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# esp_https_ota_finish() sets the boot partition unconditionally and offers
# no hook in between, so the stream is hashed in the decrypt callback --
# which runs BEFORE each esp_ota_write -- and a mismatch aborts instead.
CONFIG_ESP_HTTPS_OTA_DECRYPT_CB=y

# Each open file is a 4 KB sector cache. This board reached steady state
# with 7 KB of free heap -- 30,448 at boot, spent as the archive opened its
# files -- and could not accept a firmware push at all. docs/esp32.md warns
# against raising this number; four is the compromise that keeps a query
# able to open a file while the store holds its own.
#
# Four is still one short of the design: the index holds active_fp + tail_fp and
# xprs_app holds the log, so a range query's read_fp is the fourth and
# xi_zone_write's has nowhere to go. See the long note in the T-Deck's defaults
# for the full arithmetic and the errors it produces. Five, not six, because
# this board is an original ESP32 with no PSRAM -- it cannot spend 12 KB the way
# the T-Deck now can, and one more slot removes the failure that fires on every
# drain. NOT VALIDATED ON HARDWARE: no M5Stack is connected.
CONFIG_SDCARD_MAX_FILES=5

# The task watchdog the partition table's rollback argument relies on. It
# said "the 90 s task watchdog (panic on trigger) is what turns a hang into
# the reset that rolls back" -- and the built config had a 5 s warn-only
# watchdog, so a new image that hung simply sat there. Now it is true.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=90
CONFIG_ESP_TASK_WDT_PANIC=y

# ── A board with no PSRAM must survive its own updates ──────────────────
#
# The WiFi driver takes its dynamic buffers from the same internal heap
# everything else lives in, and the defaults (32 rx + 32 tx, ~1.6 KB each)
# are sized for a board with room to spare. This one has about 33 KB free
# once the hotspot is up, so a fast 1.4 MB push let the driver swallow the
# heap while the update handler was still checking the signature:
#
#   xprssig: ecp muladd failed: -0x0010 OUT OF MEMORY (heap free 2756,
#            largest 1088)
#   xauth:   command claiming X38364 does not verify -- discarded
#   xota_http: update refused: unsigned
#
# A valid signature, refused as unsigned, because the maths ran out of
# memory: the station could not be updated over the air at all. Capping
# the driver's appetite and asking the sender for a smaller window costs
# throughput (a push takes longer) and buys the one thing that matters --
# that it finishes. The T-Deck keeps the defaults; it has PSRAM.
# ESP-IDF 5 spells these CONFIG_ESP_WIFI_*; the CONFIG_ESP32_WIFI_* names
# are compatibility aliases and setting THOSE here changes nothing.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
