CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# This node exists to hear ESP-NOW. A station that modem-sleeps misses frames.
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# LVGL (managed component, configured via Kconfig — its CMake sets
# CONFIG_LV_CONF_SKIP=y, so lv_conf.h is ignored). Montserrat 14 is the
# Kconfig default; the bars use 12.
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_10=y
# 20 for one number: the count of stations in reach is the Radar's headline
# and was the same size as the labels around it.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_LV_MEM_SIZE_KILOBYTES=32
# The XPRS index names segments seg_<10 digits>.bin -- longer than 8.3, so
# without long-filename support every write fails while the accept counter
# still climbs. The dongle runs LFN_HEAP for the same reason.
CONFIG_FATFS_LFN_HEAP=y
# Phone browsers send >512B of headers (UA + Accept + our nsec cookie);
# the default answers them 431 'Header fields are too long'.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# A TASK WDT freeze reboots the board before the UART panic print can be
# read; the core dump keeps the culprit's name for the next boot.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
