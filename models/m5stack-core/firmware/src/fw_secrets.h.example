/* Which key may approve firmware for this board, and who may command it.
 *
 * Both are DEFAULTS, written into config once on a board that has none;
 * after that the operator owns them and can change them with a cable or
 * through the config share. Copy this file to fw_secrets.h and fill it in.
 *
 * FW_DEFAULT_KEY   the publisher's x-only public key, 64 lowercase hex.
 *                  The private half signs the xprsfw1 line (XPRS 25.8) and
 *                  never comes near this board or CI.
 * FW_DEFAULT_OWNER an npub allowed to command this station: update,
 *                  reboot, anything that acts. The callsign derives from
 *                  it, so no trust has to be learned from the air.
 *
 * Leave either empty and the station simply refuses that thing: with no
 * key pinned nothing installs, with no owner nobody may command it.
 */
#pragma once
#define FW_DEFAULT_KEY   ""
#define FW_DEFAULT_OWNER ""
