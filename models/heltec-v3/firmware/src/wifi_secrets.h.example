/*
 * Copy to wifi_secrets.h and fill in. That file is gitignored.
 *
 * The credentials matter for two reasons on this board. It is the LAN half
 * of a bridge, so without an address it has nothing to bridge to; and
 * ESP-NOW rides the channel the station is associated on, so joining the
 * SAME access point as the other devices is what puts them all on one
 * channel without anybody guessing. Leave the SSID empty to stay
 * unassociated and use ESPNOW_FALLBACK_CHANNEL instead -- which only ever
 * meets another unassociated board.
 *
 * These are DEFAULTS: written into config on a board that has none, and the
 * operator's afterwards (`cfg set ssid ...` over the cable, or the config
 * share). NVS wins over anything compiled in here.
 */
#define WIFI_SSID ""
#define WIFI_PASS ""

/* Used only when WIFI_SSID is empty. */
#define ESPNOW_FALLBACK_CHANNEL 1
