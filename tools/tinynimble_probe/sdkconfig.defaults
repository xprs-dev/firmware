# The T-Deck's console is the native USB-JTAG, like the T-Dongle's.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The controller, and ONLY the controller. No NimBLE host: that is the whole
# experiment. If BT_NIMBLE_ENABLED were set, the host would be linked and its
# msys pools allocated, which is precisely what tinynimble exists to avoid.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n

# BLE5 extended advertising has to be on in the controller or 0x2036 is
# refused with "unknown command".
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n

# The controller dedups scan reports BY ADDRESS. Left on, a fixed-address peer
# is reported once per boot and then never again -- which is exactly how a mesh
# beacon goes silent while looking healthy (docs/esp32.md).
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=1000
