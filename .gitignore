# Build output and downloaded dependencies -- all regenerated by `pio run`.
.pio/
build/
managed_components/
dependencies.lock

# PlatformIO writes the resolved sdkconfig next to each project. The INPUTS are
# tracked (sdkconfig.defaults, and each board's fragment under models/), the
# resolved output is not -- with one exception below.
sdkconfig.rns_ble5
sdkconfig.m5stack
sdkconfig.tdeck
sdkconfig.tdeck_plus
sdkconfig.tdongle
sdkconfig.espnow_probe

# Firmware images: too big to version, and produced by a build anyone can run.
# models/*/prebuilt/ is the deliberate exception, for images that were released.
*.bin
*.elf
!models/*/prebuilt/*.bin

# CREDENTIALS. Every project here keeps a committed `*.example` next to a real
# file that must never be. WiFi passwords and APRS-IS passcodes live in these.
# The pattern is deliberately path-free so a new project cannot miss it.
wifi_secrets.h
igate_secrets.h
fw_secrets.h
