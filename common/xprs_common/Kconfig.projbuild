menu "XPRS Board Selection"

    choice XPRS_BOARD
        prompt "XPRS board model"
        default XPRS_BOARD_EPAPER_1IN54

        config XPRS_BOARD_EPAPER_1IN54
            bool "ESP32-S3 ePaper 1.54 (Waveshare)"
            depends on IDF_TARGET_ESP32S3

        # The same board running the shared station (xprs_app), from its own
        # project in models/epaper-1in54/firmware. A separate choice because
        # the one above is what the multiboard build selects, and several
        # legacy components (xprs_lvgl's e-paper port, xprs_shtc3,
        # xprs_epaper_1in54) switch themselves on for it; this project brings
        # its own panel and sensor code and wants none of them.
        config XPRS_BOARD_EPAPER_STATION
            bool "ESP32-S3 ePaper 1.54 (Waveshare), xprs_app station"
            depends on IDF_TARGET_ESP32S3

        config XPRS_BOARD_TDONGLE_S3
            bool "LILYGO T-Dongle-S3 LCD"
            depends on IDF_TARGET_ESP32S3

        config XPRS_BOARD_HELTEC_V3
            bool "Heltec WiFi LoRa 32 V3"
            depends on IDF_TARGET_ESP32S3

        config XPRS_BOARD_TDECK
            bool "LILYGO T-Deck"
            depends on IDF_TARGET_ESP32S3

        config XPRS_BOARD_ESP32C3_MINI
            bool "ESP32-C3 Mini"
            depends on IDF_TARGET_ESP32C3

        config XPRS_BOARD_HELTEC_V2
            bool "Heltec WiFi LoRa 32 V2"
            depends on IDF_TARGET_ESP32

        config XPRS_BOARD_HELTEC_V1
            bool "Heltec WiFi LoRa 32 V1"
            depends on IDF_TARGET_ESP32

        config XPRS_BOARD_KV4P
            bool "KV4P-HT (SA818)"
            depends on IDF_TARGET_ESP32

        config XPRS_BOARD_GENERIC
            bool "Generic ESP32"
            depends on IDF_TARGET_ESP32

    endchoice

endmenu
